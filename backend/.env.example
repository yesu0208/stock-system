# docker-compose.yml 에서 사용하는 환경변수 (cp .env.example .env 후 값 입력, .env 는 커밋 금지)

# MySQL
MYSQL_ROOT_PASSWORD=
# 앱 전용 계정 (root 사용 불가, init-db.sh 가 bff_db / stock_db / account_db 권한 부여)
DB_USER=
DB_PASSWORD=

# Redis (compose 서비스 이름)
REDIS_HOST=redis
REDIS_PORT=6379

# 증권사 실시간 시세 API (공통)
APPROVAL_KEY_URL=
WS_URL=
CHART_API_URL=
CHART_API_APPKEY=
CHART_API_APPSECRET=

# 증권사 API 키 - stock-server A 그룹
APP_KEY=
APP_SECRET=

# 증권사 API 키 - stock-server B 그룹 (A 와 다른 키 사용)
APP_KEY_B=
APP_SECRET_B=

# bff-server
SECRET_KEY=
FE_URL=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SLACK_WEBHOOK_URL=